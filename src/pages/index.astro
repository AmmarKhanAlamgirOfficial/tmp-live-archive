---
import fs from 'fs';
import path from 'path';
import BaseLayout from '../layouts/BaseLayout.astro';

const dataDir = path.join(process.cwd(), 'public/archive-data');
let files = [];
try {
    if (fs.existsSync(dataDir)) {
        files = fs.readdirSync(dataDir).filter(file => file.endsWith('.json'));
    }
} catch (e) {
    console.error("Could not read archive-data directory:", e);
}

const totalChunks = files.length > 0 ? files.length : 1;
const highestChunkId = String(totalChunks).padStart(3, '0');

let initialPosts = [];
try {
    const chunkPath = path.join(dataDir, `archive-${highestChunkId}.json`);
    if (fs.existsSync(chunkPath)) {
        initialPosts = JSON.parse(fs.readFileSync(chunkPath, 'utf-8'));
    }
} catch (e) {
    console.error("Could not read initial archive chunk:", e);
}
---

<BaseLayout title="TMP Live Archive">
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js" is:inline></script>

    <div class="live-container" style="padding-top: 1.5rem;" id="archive-main-container">
        
        <!-- Language Switcher Bar -->
        <nav class="archive-lang-nav" id="archive-lang-nav" aria-label="Archive Language Selection">
            <button class="lang-tab active" data-lang="en" id="tab-en" type="button" aria-selected="true">
                <i class="fa-solid fa-globe"></i> English
            </button>
            <button class="lang-tab" data-lang="hi" id="tab-hi" type="button" aria-selected="false">
                <span class="lang-symbol">अ</span> हिंदी
            </button>
            <button class="lang-tab" data-lang="ur" id="tab-ur" type="button" aria-selected="false">
                <span class="lang-symbol">اردو</span> اردو
            </button>
        </nav>

        <!-- Header -->
        <header class="live-header" id="archive-header">
            <h1 id="archive-title">
                <span class="live-indicator"><span class="dot"></span></span>
                <span id="archive-title-text">TMP Live Archive</span>
            </h1>
            <p id="archive-subtitle" style="color: var(--text-muted); font-size: 0.9rem; margin-top: 0.35rem;">
                Historical archive of live updates.
            </p>
        </header>

        <!-- Dynamic Live Feed -->
        <div id="live-feed" data-current-lang="en">
            <div id="feed-loader" style="text-align: center; padding: 2.5rem; color: var(--text-muted);">
                <i class="fas fa-spinner fa-spin fa-2x"></i>
                <p style="margin-top: 0.75rem; font-weight: 600;">Loading archive updates...</p>
            </div>
        </div>

        <!-- Controls / Load More -->
        <div class="load-more-container" style="text-align: center; margin: 2rem 0 4rem 0;">
            <button id="load-more-btn" style="background-color: var(--bbc-red); color: white; border: none; padding: 12px 30px; font-size: 1rem; font-weight: 700; border-radius: 25px; cursor: pointer; text-transform: uppercase; letter-spacing: 0.05em; transition: opacity 0.2s;">
                Load Previous Updates
            </button>
            <p id="archive-end-msg" style="display: none; color: var(--text-muted); font-weight: 700; margin-top: 1rem;">
                End of archive history.
            </p>
        </div>
    </div>

    <!-- Pass build-time configuration to client script -->
    <script is:inline define:vars={{ totalChunks, initialPosts }}>
        window.__ARCHIVE_CONFIG = {
            totalChunks: totalChunks,
            initialPosts: initialPosts
        };
    </script>

    <script is:inline src="/assets/live-archive.js"></script>
</BaseLayout>